{
  "name": "@flop-tools/session-router",
  "version": "0.1.3",
  "description": "Deterministic off-chain miner selection, preflight, failover and auditable decision routing for FLOP compute-session tooling.",
  "type": "module",
  "bin": {
    "flop-router": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "START_HERE.md",
    "docs/builder-integration.md",
    "docs/inference-gateway.md",
    "examples",
    "LICENSE",
    "SECURITY.md",
    "protocol-compat.json",
    "openapi.json"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "package:smoke": "npm run build && node tools/package-smoke.js",
    "quickstart": "npm run build && node dist/src/cli.js route --request examples/request.json --candidates examples/candidates.json --db quickstart.db",
    "inference:smoke": "npm run build && node tools/inference-smoke.js",
    "inference:serve": "npm run build && node tools/serve-inference.js",
    "inference:bench": "node tools/benchmark-inference.js",
    "check": "npm run typecheck && npm test && npm run pack:check && npm run package:smoke"
  },
  "keywords": [
    "flop",
    "routing",
    "inference",
    "miner",
    "failover",
    "replay",
    "technocore",
    "ai-agents",
    "interop"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
